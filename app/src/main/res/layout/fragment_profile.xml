<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FragmentProfile">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/FRGContainerPadding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/TitleHeight"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="16dp">
            <ImageView
                android:id="@+id/IMV_FRGProfile_Back"
                android:layout_width="@dimen/imageViewIconSize"
                android:layout_height="@dimen/imageViewIconSize"
                android:padding="@dimen/imageViewIcon_Padding"
                android:src="@drawable/ic_flecha" />
            <TextView
                android:id="@+id/TXV_FRGProfile_Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/FRGProfile_Title"
                android:textSize="@dimen/titleTextSize"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="@dimen/imageViewIconSize" />
        </LinearLayout><!-- 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginTop="16dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/CRV_FRGProfile_Image"
                android:layout_width="@dimen/profile_avatar_size"
                android:layout_height="@dimen/profile_avatar_size"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="100dp">
                <ImageView
                    android:id="@+id/IMV_FRGProfile_Profile"
                    android:layout_width="@dimen/profile_avatar_size"
                    android:layout_height="@dimen/profile_avatar_size"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile" />
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/TXV_FRGProfile_UserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/FRGProfile_Text"
                android:textSize="@dimen/titleTextSize"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
            <TextView
                android:id="@+id/TXV_FRGProfile_ID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/FRGProfile_Text_ID"
                android:textSize="@dimen/FRGTextView2TextSize" />
        </LinearLayout><!-- 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/FRGContainerPadding"
            android:layout_marginTop="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_bg_size"
                    android:layout_height="@dimen/profile_icon_bg_size"
                    app:cardCornerRadius="@dimen/profile_icon_bg_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4F8">
                    <ImageView
                        android:id="@+id/IMV_FRGProfile_EmailIcon"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_email" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/profile_text_margin_start">
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Email_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_Email"
                        android:textStyle="bold"
                        android:textSize="@dimen/FRGLabelTextSize"
                        android:textColor="@color/black"/>
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_EmailX"
                        android:textSize="@dimen/FRGTextView2TextSize" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_bg_size"
                    android:layout_height="@dimen/profile_icon_bg_size"
                    app:cardCornerRadius="@dimen/profile_icon_bg_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4F8">
                    <ImageView
                        android:id="@+id/IMV_FRGProfile_NameIcon"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_user" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/profile_text_margin_start">
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Name_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_Name"
                        android:textStyle="bold"
                        android:textSize="@dimen/FRGLabelTextSize"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_NameX"
                        android:textSize="@dimen/FRGTextView2TextSize" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_bg_size"
                    android:layout_height="@dimen/profile_icon_bg_size"
                    app:cardCornerRadius="@dimen/profile_icon_bg_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4F8">
                    <ImageView
                        android:id="@+id/IMV_FRGProfile_PhoneIcon"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_phone" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/profile_text_margin_start">
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Phone_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_Phone"
                        android:textStyle="bold"
                        android:textSize="@dimen/FRGLabelTextSize"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_PhoneX"
                        android:textSize="@dimen/FRGTextView2TextSize" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_bg_size"
                    android:layout_height="@dimen/profile_icon_bg_size"
                    app:cardCornerRadius="@dimen/profile_icon_bg_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4F8">
                    <ImageView
                        android:id="@+id/IMV_FRGProfile_LocationIcon"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_location" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/profile_text_margin_start">
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Address_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_Address"
                        android:textStyle="bold"
                        android:textSize="@dimen/FRGLabelTextSize"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_AddressX"
                        android:textSize="@dimen/FRGTextView2TextSize" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_bg_size"
                    android:layout_height="@dimen/profile_icon_bg_size"
                    app:cardCornerRadius="@dimen/profile_icon_bg_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4F8">
                    <ImageView
                        android:id="@+id/IMV_FRGProfile_ScheduleIcon"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_schedule" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/profile_text_margin_start">
                    <TextView
                        android:id="@+id/TXV_FRGProfile_EntryDate_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_Date"
                        android:textStyle="bold"
                        android:textSize="@dimen/FRGLabelTextSize"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_EntryDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_DateX"
                        android:textSize="@dimen/FRGTextView2TextSize" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_bg_size"
                    android:layout_height="@dimen/profile_icon_bg_size"
                    app:cardCornerRadius="@dimen/profile_icon_bg_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4F8">
                    <ImageView
                        android:id="@+id/IMV_FRGProfile_ClockIcon"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_clock" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/profile_text_margin_start">
                    <TextView
                        android:id="@+id/TXV_FRGProfile_LastAccess_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_LastAccess"
                        android:textStyle="bold"
                        android:textSize="@dimen/FRGLabelTextSize"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_LastAccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_LastAccessX"
                        android:textSize="@dimen/FRGTextView2TextSize" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_bg_size"
                    android:layout_height="@dimen/profile_icon_bg_size"
                    app:cardCornerRadius="@dimen/profile_icon_bg_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4F8">
                    <ImageView
                        android:id="@+id/IMV_FRGProfile_GroupsIcon"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_user_groups" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/profile_text_margin_start">
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Groups_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_Groups"
                        android:textStyle="bold"
                        android:textSize="@dimen/FRGLabelTextSize"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Groups"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_GroupsX"
                        android:textSize="@dimen/FRGTextView2TextSize" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom">
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_bg_size"
                    android:layout_height="@dimen/profile_icon_bg_size"
                    app:cardCornerRadius="@dimen/profile_icon_bg_radius"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0F4F8">
                    <ImageView
                        android:id="@+id/IMV_FRGProfile_KeyIcon"
                        android:layout_width="@dimen/profile_icon_size"
                        android:layout_height="@dimen/profile_icon_size"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_key" />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/profile_text_margin_start">
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Permissions_Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_Permissions"
                        android:textStyle="bold"
                        android:textSize="@dimen/FRGLabelTextSize"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Permissions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_Text_PermissionsX"
                        android:textSize="@dimen/FRGTextView2TextSize" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout><!-- 4 -->
        <Button
            android:id="@+id/BTN_FRGProfile_ChangePassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/FRGContainerPadding"
            android:layout_marginTop="16dp"
            android:text="@string/FRGProfile_BTNChangePassword"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:backgroundTint="#F0F4F8" />
    </LinearLayout>
</ScrollView>