<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cardview_default_margin_bottom"
    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
    app:cardElevation="@dimen/cardview_default_elevation"
    android:clickable="true"
    android:focusable="true"

    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/cardview_default_padding"
        >
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/item_marginStart"
            android:layout_gravity="center_vertical"
            >
            <TextView
                android:id="@+id/TXV_ITProductList_Category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categoria: Alimentos"
                android:textSize="@dimen/ITTextViewTextSize"
                android:layout_marginBottom="@dimen/ITMarginBottom"
                />
            <TextView
                android:id="@+id/TXV_ITProductList_ProductName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arroz"
                android:textSize="@dimen/ITTextViewTextSize"
                android:layout_marginBottom="@dimen/ITMarginBottom"
                android:textStyle="bold"
                />
            <TextView
                android:id="@+id/TXV_ITProductList_Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio: 4.50 Bs."
                android:textSize="@dimen/ITTextViewTextSize"
                android:layout_marginBottom="@dimen/ITMarginBottom"
                />
            <Button
                android:id="@+id/BTN_ITProductList_Buy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ITProductList_BTNBuyProduct"
                android:textSize="@dimen/ITTextViewTextSize"
                android:paddingHorizontal="@dimen/button_padding_horizontal"
                />
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/cardview_image"
            android:layout_height="@dimen/cardview_image"
            app:cardCornerRadius="@dimen/cardview_item_corner_radius"
            android:elevation="0dp"
            >
            <ImageView
                android:id="@+id/IMV_ITProductList_ProductImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/product"
                android:src="@drawable/ic_surmarket"/>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</androidx.cardview.widget.CardView>